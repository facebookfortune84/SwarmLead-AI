# ── Public domain (SINGLE SOURCE OF TRUTH) ────────────────────────────────
# Change THIS ONE variable to move the whole product to a new domain.
# Everything else (CORS, SEO, sitemap, OG tags, share links, tenant
# subdomains) derives from it. Give it bare (example.com) or with scheme.
PUBLIC_DOMAIN=realms2riches.com
# Optional overrides (only if you split hosts):
# API_DOMAIN=api.example.com
# FRONTEND_URL=https://example.com
# BACKEND_URL=https://api.example.com
# CORS_ORIGINS=https://extra.example.com
# ── Cloudflare Tunnel (free hosting) ──────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=                      # from Zero Trust dashboard
# CLOUDFLARE_TUNNEL_HOSTNAME=                   # trycloudflare staging URL
FRONTEND_URL=
